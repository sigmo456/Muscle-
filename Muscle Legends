-- LOCK POSITION (УЛУЧШЕННАЯ - ФИКСАЦИЯ ПОЗИЦИИ И ПОВОРОТА)
function lockPlayerPosition()
    if not lockPosition then return end
    if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then return end
    
    local currentCFrame = player.Character.HumanoidRootPart.CFrame
    local currentPos = currentCFrame.Position
    
    -- Проверяем расстояние до целевой позиции
    local distance = (currentPos - targetPosition).Magnitude
    
    -- Проверяем разницу в повороте (используем LookVector для направления)
    local currentLook = currentCFrame.LookVector
    local targetLook = targetCFrame.LookVector
    local dotProduct = currentLook:Dot(targetLook)
    
    -- Если сдвинулись больше чем на 0.5 studs ИЛИ повернулись больше чем на 15 градусов
    if distance > 0.5 or dotProduct < 0.9659 then -- 0.9659 ≈ cos(15°)
        -- Возвращаем на исходную позицию и поворот
        player.Character.HumanoidRootPart.CFrame = targetCFrame
    end
end

-- КНОПКИ МЕНЮ
local function createMenuButton(text, yPos, variableType)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.8, 0, 0, 35)
    btn.Position = UDim2.new(0.1, 0, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 16
    btn.BorderSizePixel = 1
    btn.BorderColor3 = Color3.fromRGB(100, 100, 100)
    btn.ZIndex = 6
    btn.Parent = menuFrame
    
    local function updateButton()
        if variableType == "train" then
            btn.Text = autoTrain and "💪 TRAIN: ON" or "💪 TRAIN: OFF"
            btn.BackgroundColor3 = autoTrain and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(60, 60, 60)
        elseif variableType == "lock" then
            btn.Text = lockPosition and "🔒 LOCK: ON" or "🔒 LOCK: OFF"
            btn.BackgroundColor3 = lockPosition and Color3.fromRGB(150, 100, 0) or Color3.fromRGB(60, 60, 60)
        elseif variableType == "rebirth" then
            btn.Text = autoRebirth and "🔄 REBIRTH: ON" or "🔄 REBIRTH: OFF"
            btn.BackgroundColor3 = autoRebirth and Color3.fromRGB(0, 0, 150) or Color3.fromRGB(60, 60, 60)
        elseif variableType == "punch" then
            btn.Text = autoPunch and "🥊 PUNCH: ON" or "🥊 PUNCH: OFF"
            btn.BackgroundColor3 = autoPunch and Color3.fromRGB(150, 0, 0) or Color3.fromRGB(60, 60, 60)
        end
    end
    
    updateButton()
    
    btn.MouseButton1Click:Connect(function()
        if variableType == "train" then
            autoTrain = not autoTrain
            if autoTrain then
                print("💪 Auto Train включен! (0.05сек)")
                autoEquipDumbbell()
            else
                print("💪 Auto Train выключен!")
            end
        elseif variableType == "lock" then
            lockPosition = not lockPosition
            if lockPosition and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                -- Запоминаем не только позицию, но и поворот (CFrame)
                targetCFrame = player.Character.HumanoidRootPart.CFrame
                targetPosition = targetCFrame.Position
                print("📍 Position & Rotation locked!")
            elseif not lockPosition then
                targetPosition = nil
                targetCFrame = nil
                print("🔓 Position & Rotation unlocked!")
            end
        elseif variableType == "rebirth" then
            autoRebirth = not autoRebirth
            if autoRebirth then
                print("🔄 Auto Rebirth включен! (0.5сек + телепорт + тренировка + анти-игрок 120 studs)")
                teleportToRebirthPosition()
                autoEquipDumbbell()
            else
                print("🔄 Auto Rebirth выключен!")
            end
        elseif variableType == "punch" then
            autoPunch = not autoPunch
            if autoPunch then
                print("🥊 Auto Punch включен! (0.05сек + авто-экипировка кулаков)")
                autoEquipPunch()
            else
                print("🥊 Auto Punch выключен!")
            end
        end
        updateButton()
    end)
    
    return btn
end

