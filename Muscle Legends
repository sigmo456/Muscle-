-- ПОИСК rebirthRemote
function findRebirthRemote()
    local rebirthRemote = ReplicatedStorage:FindFirstChild("rEvents") and ReplicatedStorage.rEvents:FindFirstChild("rebirthRemote")
    if rebirthRemote then
        return rebirthRemote
    end
    return nil
end

-- АВТО-ЭКИПИРОВКА КУЛАКОВ
function autoEquipPunch()
    if not autoPunch then return end
    if tick() - lastEquipTime < 3 then return end
    
    if player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
        local hasPunch = false
        for _, tool in pairs(player.Character:GetChildren()) do
            if tool:IsA("Tool") and string.find(string.lower(tool.Name), "punch") then
                hasPunch = true
                break
            end
        end
        
        if not hasPunch then
            local backpack = player:FindFirstChild("Backpack")
            if backpack then
                for _, tool in pairs(backpack:GetChildren()) do
                    if tool:IsA("Tool") and string.find(string.lower(tool.Name), "punch") then
                        if player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
                            tool.Parent = player.Character
                            lastEquipTime = tick()
                            print("🥊 Авто-экипировка кулаков: " .. tool.Name)
                            return
                        end
                    end
                end
            end
        end
    end
end

-- АВТО-БИТЬЕ КУЛАКАМИ
function autoPunchFunction()
    if not autoPunch then return end
    if tick() - lastPunchTime < 0.05 then return end
    
    pcall(function()
        -- Сначала убедимся что кулаки экипированы
        if player.Character and not player.Character:FindFirstChildOfClass("Tool") then
            autoEquipPunch()
            return
        end
        
        -- Пробуем основные RemoteEvents для удара
        local mainRemotes = {
            ReplicatedStorage:FindFirstChild("Click"),
            ReplicatedStorage:FindFirstChild("Train"), 
            ReplicatedStorage:FindFirstChild("Exercise"),
            ReplicatedStorage:FindFirstChild("Punch")
        }
        
        for _, remote in pairs(mainRemotes) do
            if remote and remote:IsA("RemoteEvent") then
                remote:FireServer()
                break
            end
        end
        
        -- Пробуем rEvents
        local rEvents = ReplicatedStorage:FindFirstChild("rEvents")
        if rEvents then
            for _, remote in pairs(rEvents:GetChildren()) do
                if remote:IsA("RemoteEvent") and (string.find(string.lower(remote.Name), "click") or
                                                string.find(string.lower(remote.Name), "train") or
                                                string.find(string.lower(remote.Name), "exercise") or
                                                string.find(string.lower(remote.Name), "punch")) then
                    remote:FireServer()
                end
            end
        end
        
        -- Активируем инструмент
        if player.Character then
            local tool = player.Character:FindFirstChildOfClass("Tool")
            if tool then
                pcall(function()
                    tool:Activate()
                end)
            end
        end
        
        lastPunchTime = tick()
    end)
end

-- МОМЕНТАЛЬНАЯ ПРОВЕРКА ИГРОКОВ В РАДИУСЕ 120 STUDS
function checkNearbyPlayers()
    if not autoRebirth then return false end
    
    if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
        return false
    end
    
    local myPosition = player.Character.HumanoidRootPart.Position
    
    for _, otherPlayer in pairs(Players:GetPlayers()) do
        if otherPlayer ~= player and otherPlayer.Character and otherPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local otherPosition = otherPlayer.Character.HumanoidRootPart.Position
            local distance = (myPosition - otherPosition).Magnitude
            
            if distance <= 120 then
                print("🚨 МГНОВЕННО обнаружен игрок в радиусе 120 studs: " .. otherPlayer.Name .. " (расстояние: " .. math.floor(distance) .. ")")
                return true
            end
        end
    end
    
    return false
end

-- МГНОВЕННАЯ ТЕЛЕПОРТАЦИЯ ПРИ ОБНАРУЖЕНИИ ИГРОКА
function instantAntiPlayerCheck()
    if not autoRebirth then return end
    if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then return end
    
    if checkNearbyPlayers() then
        teleportToRandomSafePosition()
    end
end

-- ТЕЛЕПОРТАЦИЯ НА СЛУЧАЙНУЮ БЕЗОПАСНУЮ ПОЗИЦИЮ
function teleportToRandomSafePosition()
    if not autoRebirth then return end
    if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then return end
    
    local randomIndex = math.random(1, #safePositions)
    local safePosition = safePositions[randomIndex]
    
    currentSafePosition = safePosition
    player.Character.HumanoidRootPart.CFrame = CFrame.new(safePosition)
    print("🛡️ МГНОВЕННО телепортирован на безопасную позицию " .. randomIndex)
end

-- ВЫЗОВ ПЕРЕРОЖДЕНИЯ
function callRebirth()
    if not autoRebirth then return end
    if tick() - lastRebirthTime < 0.5 then return end
    
    local rebirthRemote = findRebirthRemote()
    if rebirthRemote then
        pcall(function()
            if rebirthRemote:IsA("RemoteFunction") then
                rebirthRemote:InvokeServer("rebirthRequest")
            elseif rebirthRemote:IsA("RemoteEvent") then
                rebirthRemote:FireServer("rebirthRequest")
            end
            print("🔄 Перерождение вызвано")
            lastRebirthTime = tick()
        end)
    else
        print("❌ Rebirth remote не найден!")
    end
end

-- ТЕЛЕПОРТАЦИЯ НА КООРДИНАТЫ ПЕРЕРОЖДЕНИЯ
function teleportToRebirthPosition()
    if not autoRebirth then return end
    if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then return end
    
    if currentSafePosition then
        local currentPos = player.Character.HumanoidRootPart.Position
        local distanceToSafe = (currentPos - currentSafePosition).Magnitude
        
        if distanceToSafe <= 10 then
            print("📍 Остаюсь на безопасной позиции")
            return
        end
    end
    
    player.Character.HumanoidRootPart.CFrame = CFrame.new(rebirthPosition)
    currentSafePosition = nil
    print("📍 Телепортирован на позицию перерождения")
end

